local function QueueScript()
    local scriptStr = game:HttpGet("https://raw.githubusercontent.com/r1lkizz/Aimbot-Assistant-v2.0/refs/heads/main/script")
    if queue_on_teleport then
        queue_on_teleport(scriptStr)
    elseif queueonteleport then
        queueonteleport(scriptStr)
    elseif syn and syn.queue_on_teleport then
        syn.queue_on_teleport(scriptStr)
    end
end

-- ✅ ОБЩАЯ ФУНКЦИЯ ДЛЯ ПОИСКА СЕРВЕРОВ (Обновленная)
local function HopToServer(filterFunc)
    notify("Misc", "Searching for server...", "info", 3)
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, res = pcall(function() return game:HttpGet(url) end)
    
    if ok and res then
        local success, data = pcall(function() return HttpService:JSONDecode(res) end)
        if success and data and data.data then
            local bestServer = nil
            local maxPlayersCount = -1

            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId then
                    -- 1. Сначала ищем идеальное совпадение по фильтру (например, 1-3 свободных места)
                    if filterFunc(server.playing, server.maxPlayers) then
                        notify("Misc", "Joining server...", "success", 2)
                        task.wait(0.5)
                        QueueScript()
                        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        return
                    end
                    
                    -- 2. Запоминаем сервер с максимальным количеством игроков (на случай, если идеального нет)
                    if server.playing > maxPlayersCount then
                        maxPlayersCount = server.playing
                        bestServer = server
                    end
                end
            end

            -- Если идеального не нашли, но есть "почти полный" — заходим туда
            if bestServer then
                notify("Misc", "No perfect match. Joining the fullest available server.", "info", 3)
                task.wait(0.5)
                QueueScript()
                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, bestServer.id, LocalPlayer)
                return
            end
        end
    end
    notify("Misc", "No suitable servers found.", "error", 3)
end

