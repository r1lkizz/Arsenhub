local function safeColor(c, fallback)
    if not c then return fallback end
    if typeof(c) == "Color3" then return c end
    if type(c) == "table" then
        if c.Color and typeof(c.Color) == "Color3" then return c.Color end
        if c.R and c.G and c.B then return Color3.new(c.R, c.G, c.B) end
    end
    return fallback
end

local function isSameTeam(p)
    if not p or p == LocalPlayer then return true end
    if p.Team and LocalPlayer.Team then return p.Team == LocalPlayer.Team end
    if p.TeamColor and LocalPlayer.TeamColor then return p.TeamColor == LocalPlayer.TeamColor end
    return false
end

local function getElementColor(p, element)
    if S.UseTeamColor then
        return isSameTeam(p) and S.TeamColor or S.EnemyColor
    end
    if element == "box" then return S.ColorBox end
    if element == "boxfill" then return S.ColorBoxFill end
    if element == "name" then return S.ColorName end
    if element == "health" then return S.ColorHealth end
    if element == "tracer" then return S.ColorTracer end
    if element == "skeleton" then return S.ColorSkeleton end
    if element == "headdot" then return S.ColorHeadDot end
    if element == "chams" then return S.ColorChams end
    return Color3.new(1, 1, 1)
end

local function viewportOrigin()
    local vp = Camera.ViewportSize
    if S.TracerOrigin == "Bottom" then return Vector2.new(vp.X/2, vp.Y) end
    if S.TracerOrigin == "Top"    then return Vector2.new(vp.X/2, 0)    end
    if S.TracerOrigin == "Left"   then return Vector2.new(0, vp.Y/2)    end
    if S.TracerOrigin == "Right"  then return Vector2.new(vp.X, vp.Y/2) end
    return Vector2.new(vp.X/2, vp.Y/2)
end

local function getUniformBounds(character)
    local ok, cf, size = pcall(function() return character:GetBoundingBox() end)
    if not ok or not cf then return nil end
    local hx, hy, hz = size.X * 0.55, size.Y * 0.55, size.Z * 0.55
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local any = false
    for i = 0, 7 do
        local sx = (i % 2 == 0) and -1 or 1
        local sy = (math.floor(i / 2) % 2 == 0) and -1 or 1
        local sz = (math.floor(i / 4) % 2 == 0) and -1 or 1
        local world = (cf * CFrame.new(hx*sx, hy*sy, hz*sz)).Position
        local sp = Camera:WorldToViewportPoint(world)
        if sp.Z > 0 then
            if sp.X < minX then minX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y > maxY then maxY = sp.Y end
            any = true
        end
    end
    if not any then return nil end
    return minX, minY, maxX, maxY
end

