-- ─── 17. Main render loop ──────────────────────────────────────────────────
local renderConn
renderConn = RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if S.AimEnabled then
        fovCircle.Position = screenCenter
        fovCircle.Radius = S.AimFOV
        fovCircle.Color = S.AimFOVColor
        fovCircle.Visible = true
    else
        fovCircle.Visible = false
    end

    if S.AimEnabled and RUNNING then
        if isAimKeyPressed() then
            local targetPart = getClosestTarget()
            if targetPart then
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
                if S.AimSmooth <= 1 then Camera.CFrame = targetCFrame
                else Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 / S.AimSmooth) end
            end
        end
    end

    if S.SilentAimEnabled and S.ShowSilentFOV then
        local target = getSilentTarget()
        silentFovCircle.Position = screenCenter
        silentFovCircle.Radius = S.SilentAimFOV
        silentFovCircle.Visible = true
        if target then
            silentFovCircle.Color = S.SilentFOVColor
            silentFovCircle.Transparency = 1
            silentFovCircle.Thickness = 2
        else
            silentFovCircle.Color = S.SilentFOVIdleColor
            silentFovCircle.Transparency = 0.4
            silentFovCircle.Thickness = 1
        end
    else
        silentFovCircle.Visible = false
    end

    if flyActive and flyBV and flyBG then
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then stopFly()
        else
            local look  = Camera.CFrame.LookVector
            local right = Camera.CFrame.RightVector
            local up    = Vector3.new(0, 1, 0)
            local move  = Vector3.zero
            if keysDown[Enum.KeyCode.W] then move = move + look end
            if keysDown[Enum.KeyCode.S] then move = move - look end
            if keysDown[Enum.KeyCode.D] then move = move + right end
            if keysDown[Enum.KeyCode.A] then move = move - right end
            if keysDown[Enum.KeyCode.Space] then move = move + up end
            if keysDown[Enum.KeyCode.LeftControl] then move = move - up end
            flyBV.Velocity = (move.Magnitude > 0) and (move.Unit * S.FlySpeed) or Vector3.zero
            flyBG.CFrame = CFrame.new(Vector3.zero, look)
        end
    end

    if S.NoclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end

    if S.AntiFlingEnabled then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if hrp.AssemblyLinearVelocity.Magnitude > 500 then hrp.AssemblyLinearVelocity = Vector3.zero end
                if hrp.AssemblyAngularVelocity.Magnitude > 50 then hrp.AssemblyAngularVelocity = Vector3.zero end
            end
        end
    end

    if not RUNNING or not S.Enabled then
        for _, d in pairs(playerData) do hideAll(d) end
        return
    end

    frameCounter = frameCounter + 1
    local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPosCached = localRoot and localRoot.Position or Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        updatePlayer(p, frameCounter, myPosCached)
    end
end)

