local function getClosestTarget()
    local closestPart = nil
    local shortestDist = S.AimFOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    if S.PriorityTarget and S.PriorityTarget ~= "None" then
        local prioPlayer = Players:FindFirstChild(S.PriorityTarget)
        if prioPlayer and prioPlayer.Character
           and not (S.AimTeamCheck and isSameTeam(prioPlayer)) then
            local hum = prioPlayer.Character:FindFirstChildOfClass("Humanoid")
            local root = prioPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local tp = partFromIndex(prioPlayer.Character, S.AimPart)
                if tp then
                    local vis = true
                    if S.AimWallCheck then
                        aimRayParams.FilterDescendantsInstances = { LocalPlayer.Character, prioPlayer.Character }
                        local r = workspace:Raycast(Camera.CFrame.Position, tp.Position - Camera.CFrame.Position, aimRayParams)
                        if r then vis = false end
                    end
                    if vis then return tp end
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Name ~= S.IgnoreTarget then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root then
                if not (S.AimTeamCheck and isSameTeam(p)) then
                    local tp = partFromIndex(p.Character, S.AimPart)
                    if tp then
                        local sp, onScreen = Camera:WorldToViewportPoint(tp.Position)
                        if onScreen then
                            local dd = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
                            if dd < shortestDist then
                                local vis = true
                                if S.AimWallCheck then
                                    aimRayParams.FilterDescendantsInstances = { LocalPlayer.Character, p.Character }
                                    local r = workspace:Raycast(Camera.CFrame.Position, tp.Position - Camera.CFrame.Position, aimRayParams)
                                    if r then vis = false end
                                end
                                if vis then shortestDist = dd; closestPart = tp end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

local function isAimKeyPressed()
    if S.AimAlways then return true end
    if not S.AimKey then return false end
    if typeof(S.AimKey) == "EnumItem" then
        if S.AimKey.EnumType == Enum.KeyCode then return UserInputService:IsKeyDown(S.AimKey) end
        if S.AimKey.EnumType == Enum.UserInputType then return UserInputService:IsMouseButtonPressed(S.AimKey) end
    end
    return false
end

