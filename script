-- ─── 8. Silent Aim core ────────────────────────────────────────────────────
local getSilentTarget, isSilentAimActive
do
    local function findTargetInFOV(fov, partSel, teamCheck, wallCheck)
        local sc = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local closest, closestDist = nil, fov
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and root then
                    if not (teamCheck and isSameTeam(p)) then
                        local tp = partFromIndex(p.Character, partSel)
                        if tp then
                            local sp, onScreen = Camera:WorldToViewportPoint(tp.Position)
                            if onScreen then
                                local d = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
                                if d < closestDist then
                                    local blocked = false
                                    if wallCheck then
                                        local rp = RaycastParams.new()
                                        rp.FilterType = Enum.RaycastFilterType.Exclude
                                        rp.FilterDescendantsInstances = { LocalPlayer.Character, p.Character }
                                        local hit = workspace:Raycast(Camera.CFrame.Position, tp.Position - Camera.CFrame.Position, rp)
                                        if hit then blocked = true end
                                    end
                                    if not blocked then
                                        closestDist = d
                                        closest = tp
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return closest
    end

    getSilentTarget = function()
        return findTargetInFOV(S.SilentAimFOV, S.SilentAimPart, S.SilentAimTeamCheck, S.SilentAimWallCheck)
    end

    isSilentAimActive = function()
        if not S.SilentAimEnabled then return false end
        if S.SilentAimAlways then return true end
        if not S.SilentAimKey then return false end
        if typeof(S.SilentAimKey) == "EnumItem" then
            if S.SilentAimKey.EnumType == Enum.KeyCode then
                return UserInputService:IsKeyDown(S.SilentAimKey)
            elseif S.SilentAimKey.EnumType == Enum.UserInputType then
                return UserInputService:IsMouseButtonPressed(S.SilentAimKey)
            end
        end
        return false
    end

    local function dbg(msg)
        if S.SilentAimDebug then print("[AA-Silent] " .. msg) end
    end

    local function isShotOrigin(origin, direction)
        if typeof(origin) ~= "Vector3" then return false end
        if typeof(direction) ~= "Vector3" then return false end
        if direction.Magnitude < 5 then return false end

        local nearCam = (origin - Camera.CFrame.Position).Magnitude < 15
        local nearChar = false
        local char = LocalPlayer.Character
        if char then
            for _, name in ipairs({ "Head", "HumanoidRootPart" }) do
                local part = char:FindFirstChild(name)
                if part and (origin - part.Position).Magnitude < 15 then
                    nearChar = true; break
                end
            end
            if not nearChar then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") then
                        local handle = t:FindFirstChild("Handle")
                        if handle and (origin - handle.Position).Magnitude < 15 then
                            nearChar = true; break
                        end
                    end
                end
            end
        end
        return (nearCam or nearChar)
    end

    task.spawn(function()
        task.wait(0.5)
        if not hookfunction then return end

        print("[AA] Installing Silent Aim hooks...")
        local hookedCount = 0
        local isHooking = false

        local function protectHook(original, callback)
            return hookfunction(original, function(...)
                if isHooking then return original(...) end
                if not checkcaller() and RUNNING and isSilentAimActive() then
                    isHooking = true
                    local ok, res = pcall(callback, ...)
                    isHooking = false
                    if ok then return res end
                end
                return original(...)
            end)
        end

        pcall(function()
            protectHook(workspace.Raycast, function(self, origin, direction, params)
                if isShotOrigin(origin, direction) then
                    local t = getSilentTarget()
                    if t then dbg("Raycast → " .. (t.Parent and t.Parent.Name or "?")); return self:Raycast(origin, t.Position - origin, params) end
                end
                return self:Raycast(origin, direction, params)
            end)
            hookedCount = hookedCount + 1
        end)

        pcall(function()
            local oldSC = workspace.Spherecast
            if oldSC then
                protectHook(oldSC, function(self, origin, radius, direction, params)
                    if isShotOrigin(origin, direction) then
                        local t = getSilentTarget()
                        if t then dbg("Spherecast → " .. (t.Parent and t.Parent.Name or "?")); return self:Spherecast(origin, radius, t.Position - origin, params) end
                    end
                    return self:Spherecast(origin, radius, direction, params)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        pcall(function()
            local oldBC = workspace.Blockcast
            if oldBC then
                protectHook(oldBC, function(self, cframe, size, direction, params)
                    if isShotOrigin(cframe.Position, direction) then
                        local t = getSilentTarget()
                        if t then dbg("Blockcast → " .. (t.Parent and t.Parent.Name or "?")); return self:Blockcast(cframe, size, t.Position - cframe.Position, params) end
                    end
                    return self:Blockcast(cframe, size, direction, params)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        pcall(function()
            local oldRCE = workspace.RaycastEndpoint
            if oldRCE then
                protectHook(oldRCE, function(self, origin, endpoint, params)
                    if isShotOrigin(origin, endpoint - origin) then
                        local t = getSilentTarget()
                        if t then dbg("RaycastEndpoint → " .. (t.Parent and t.Parent.Name or "?")); return self:RaycastEndpoint(origin, t.Position, params) end
                    end
                    return self:RaycastEndpoint(origin, endpoint, params)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        pcall(function()
            local oldFPL = workspace.FindPartOnRayWithIgnoreList
            if oldFPL then
                protectHook(oldFPL, function(self, ray, ignoreList, ...)
                    if typeof(ray) == "Instance" and ray:IsA("Ray") and isShotOrigin(ray.Origin, ray.Direction) then
                        local t = getSilentTarget()
                        if t then dbg("FindPartOnRayWithIgnoreList → " .. (t.Parent and t.Parent.Name or "?")); return self:FindPartOnRayWithIgnoreList(Ray.new(ray.Origin, t.Position - ray.Origin), ignoreList, ...) end
                    end
                    return self:FindPartOnRayWithIgnoreList(ray, ignoreList, ...)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        pcall(function()
            local oldVPTR = Camera.ViewportPointToRay
            if oldVPTR then
                protectHook(oldVPTR, function(self, x, y, depth)
                    local t = getSilentTarget()
                    if t then
                        dbg("ViewportPointToRay → " .. (t.Parent and t.Parent.Name or "?"))
                        return Ray.new(Camera.CFrame.Position, (t.Position - Camera.CFrame.Position).Unit)
                    end
                    return self:ViewportPointToRay(x, y, depth)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        pcall(function()
            local oldSPTR = Camera.ScreenPointToRay
            if oldSPTR then
                protectHook(oldSPTR, function(self, x, y, depth)
                    local t = getSilentTarget()
                    if t then return Ray.new(Camera.CFrame.Position, (t.Position - Camera.CFrame.Position).Unit) end
                    return self:ScreenPointToRay(x, y, depth)
                end)
                hookedCount = hookedCount + 1
            end
        end)

        print("[AA] ✅ Silent Aim: " .. hookedCount .. "/7 hooks installed (Anti-Crash active)")
    end)

    task.spawn(function()
        task.wait(1)
        if not hookmetamethod then return end
        local mouse = LocalPlayer:GetMouse()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if not checkcaller() and RUNNING and isSilentAimActive() and self == mouse then
                if key == "Hit" then
                    local t = getSilentTarget()
                    if t then dbg("Mouse.Hit → " .. (t.Parent and t.Parent.Name or "?")); return CFrame.new(t.Position) end
                elseif key == "Target" then
                    local t = getSilentTarget()
                    if t then return t end
                end
            end
            return oldIndex(self, key)
        end)
    end)
end

