local function partFromIndex(character, idx)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    if idx == 1 then return character:FindFirstChild("Head") or root
    elseif idx == 2 then return root
    elseif idx == 3 then return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or root
    elseif idx == 4 then return character:FindFirstChild("LowerTorso") or root
    end
    return root
end

