local function serializeValue(v)
    local t = typeof(v)
    if t == "Color3" then
        return { __type = "Color3", R = v.R, G = v.G, B = v.B }
    elseif t == "EnumItem" then
        return { __type = "EnumItem", enumType = tostring(v.EnumType):gsub("^Enum%.", ""), name = v.Name }
    elseif t == "Vector2" then
        return { __type = "Vector2", X = v.X, Y = v.Y }
    end
    return v
end

local function deserializeValue(v)
    if type(v) == "table" and v.__type then
        if v.__type == "Color3" then return Color3.new(v.R, v.G, v.B)
        elseif v.__type == "EnumItem" then
            local et = Enum[v.enumType]
            if et then local item = et[v.name]; if item then return item end end
        elseif v.__type == "Vector2" then return Vector2.new(v.X, v.Y) end
    end
    return v
end

local function updateElement(el, value)
    if not el then return end
    if pcall(function() el:Set(value) end) then return end
    if pcall(function() el:SetValue(value) end) then return end
    pcall(function() el.Value = value end)
end

local function syncUIFromS()
    for key, el in pairs(UI) do
        local val = S[key]
        if val ~= nil then updateElement(el, val) end
    end
end

