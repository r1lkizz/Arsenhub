local function onCharacter(player, character)
    createData(player)
    task.spawn(function()
        local t = 0
        while t < 5 do
            if character.Parent and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then break end
            task.wait(0.1); t = t + 0.1
        end
        if player.Character == character then setupCharacter(player, character) end
    end)
end

Players.PlayerAdded:Connect(function(p)
    createData(p)
    p.CharacterAdded:Connect(function(c) onCharacter(p, c) end)
    if p.Character then onCharacter(p, p.Character) end
end)
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        createData(p)
        p.CharacterAdded:Connect(function(c) onCharacter(p, c) end)
        if p.Character then onCharacter(p, p.Character) end
    end
end
Players.PlayerRemoving:Connect(function(p) destroyData(p) end)

-- ─── 19. Smooth UI + Force Mouse Unlock ────────────────────────────────────
task.spawn(function()
    task.wait(0.15)
    local rootFrame = nil
    do
        local names = { "Gui", "MainGui", "Frame", "MainFrame", "Root", "Holder", "Main", "UI", "Container", "ScreenGui" }
        for _, name in ipairs(names) do
            local ok, f = pcall(function() return Window[name] end)
            if ok and f and typeof(f) == "Instance" and f:IsA("GuiObject") then rootFrame = f; break end
            local ok2, f2 = pcall(function() return Library[name] end)
            if ok2 and f2 and typeof(f2) == "Instance" and f2:IsA("GuiObject") then rootFrame = f2; break end
        end
        if not rootFrame then
            pcall(function()
                for _, gui in ipairs(CoreGui:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        for _, child in ipairs(gui:GetChildren()) do
                            if child:IsA("Frame") and child.Size.X.Offset >= 400 and child.Size.Y.Offset >= 300 then
                                rootFrame = child; return
                            end
                        end
                    end
                end
            end)
        end
        if not rootFrame then
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if pg then
                    for _, gui in ipairs(pg:GetChildren()) do
                        if gui:IsA("ScreenGui") then
                            for _, child in ipairs(gui:GetChildren()) do
                                if child:IsA("Frame") and child.Size.X.Offset >= 400 then
                                    rootFrame = child; return
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

    local canvas = nil
    if rootFrame then
        for _, d in ipairs(rootFrame:GetDescendants()) do
            if d:IsA("CanvasGroup") then canvas = d; break end
        end
    end

    local uiScale = nil
    if rootFrame then
        local ok, s = pcall(function() return rootFrame:FindFirstChildOfClass("UIScale") end)
        if ok and s then uiScale = s
        else uiScale = Instance.new("UIScale"); uiScale.Scale = 1; uiScale.Parent = rootFrame end
    end

    local scaleTarget = 1
    local transparencyTarget = (rootFrame and rootFrame.Visible) and 0 or 1

    if rootFrame then
        local intercepting = false
        pcall(function()
            rootFrame:GetPropertyChangedSignal("Visible"):Connect(function()
                if intercepting then return end
                if not rootFrame.Visible then
                    transparencyTarget = 1
                    scaleTarget = 0.92
                    if canvas and canvas.GroupTransparency < 0.99 then
                        intercepting = true
                        rootFrame.Visible = true
                        intercepting = false
                    end
                else
                    transparencyTarget = 0
                    scaleTarget = 1
                    if uiScale then uiScale.Scale = 0.92 end
                end
            end)
        end)
        RunService.RenderStepped:Connect(function()
            if canvas then
                local cur = canvas.GroupTransparency
                if math.abs(cur - transparencyTarget) < 0.005 then
                    canvas.GroupTransparency = transparencyTarget
                    if transparencyTarget >= 0.99 and rootFrame.Visible then rootFrame.Visible = false end
                else
                    canvas.GroupTransparency = cur + (transparencyTarget - cur) * 0.25
                end
            end
            if uiScale then
                local cur = uiScale.Scale
                if math.abs(cur - scaleTarget) > 0.005 then
                    uiScale.Scale = cur + (scaleTarget - cur) * 0.3
                end
            end
        end)
    end

    local manualToggle = false
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        local key = Enum.KeyCode.LeftAlt
        pcall(function() key = Window.ToggleKey or Library.ToggleKey or Enum.KeyCode.LeftAlt end)
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
            manualToggle = not manualToggle
        end
    end)

    local function isMenuOpen()
        for _, p in ipairs({ "Open", "IsOpen" }) do
            local ok, v = pcall(function() return Window[p] end)
            if ok and type(v) == "boolean" then return v end
            local ok2, v2 = pcall(function() return Library[p] end)
            if ok2 and type(v2) == "boolean" then return v2 end
        end
        if rootFrame then
            if canvas then return rootFrame.Visible and canvas.GroupTransparency < 0.5 end
            return rootFrame.Visible
        end
        return manualToggle
    end

    local wasOpen = false
    local savedBehavior = Enum.MouseBehavior.Default
    local savedIcon = true

    RunService.RenderStepped:Connect(function()
        local open = isMenuOpen()
        if open and not wasOpen then
            savedBehavior = UserInputService.MouseBehavior
            savedIcon = UserInputService.MouseIconEnabled
            wasOpen = true
        elseif not open and wasOpen then
            pcall(function() UserInputService.MouseBehavior = savedBehavior end)
            pcall(function() UserInputService.MouseIconEnabled = savedIcon end)
            wasOpen = false
        end
        if open then
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then UserInputService.MouseIconEnabled = true end
        end
    end)
    print("[AA] Smooth UI + Force Mouse Unlock enabled")
end)

