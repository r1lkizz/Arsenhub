local function destroyData(player)
    local d = playerData[player]; if not d then return end
    for _, l in ipairs(d.box)       do pcall(function() l:Remove() end) end
    for _, l in ipairs(d.skelLines) do pcall(function() l:Remove() end) end
    for _, key in ipairs({ "boxFill", "healthBg", "healthBar", "tracer", "headDot" }) do
        if d[key] then pcall(function() d[key]:Remove() end) end
    end
    if d.highlight then pcall(function() d.highlight:Destroy() end) end
    if d.gui then pcall(function() d.gui:Destroy() end) end
    playerData[player] = nil
end

local function hideAll(d)
    if not d or d._hidden then return end
    d._hidden = true
    for _, l in ipairs(d.box) do l.Visible = false end
    for _, l in ipairs(d.skelLines) do l.Visible = false end
    for _, key in ipairs({ "boxFill", "healthBg", "healthBar", "tracer", "headDot" }) do
        if d[key] then d[key].Visible = false end
    end
    if d.highlight then d.highlight.Enabled = false end
    if d.gui then d.gui.Enabled = false end
end

local function clearAll()
    for p in pairs(playerData) do destroyData(p) end
end

local function setupCharacter(player, character)
    local d = playerData[player]; if not d then return end
    d.skelConns = {}
    for _, m in ipairs(character:GetDescendants()) do
        if m:IsA("Motor6D") and m.Part0 and m.Part1 then
            table.insert(d.skelConns, { m.Part0, m.Part1 })
        end
    end
    while #d.skelLines < #d.skelConns do table.insert(d.skelLines, newLine()) end
    
    d.highlight.Adornee = character
    d.highlight.Parent  = character
    
    -- ✅ ФИКС: Принудительно переносим GUI на нового персонажа при респавне
    if d.gui then 
        d.gui.Parent = character 
    end
end

local function updatePlayer(player, fc, myPosCached)
    if not player or not player.Parent then return end
    if player == LocalPlayer then return end
    
    local d = playerData[player]

    if S.TeamCheck and isSameTeam(player) then
        if d then hideAll(d) end
        return
    end

    local character = player.Character
    if not character or not character.Parent then
        if d then hideAll(d) end
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root     = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not root.Parent then
        if d then hideAll(d) end
        return
    end

    local dist = (myPosCached - root.Position).Magnitude
    if dist > S.MaxDistance then
        if d then hideAll(d) end
        return
    end

    local data = d or createData(player)
    data._hidden = false

    local minX, minY, maxX, maxY = getUniformBounds(character)
    if not minX then hideAll(data); return end

    local alpha = 1
    if S.FadeByDistance then
        alpha = math.clamp(1 - (dist / S.MaxDistance) * 0.7, 0.3, 1)
    end

    -- ✅ ФИКС ЦВЕТА ЗА СТЕНОЙ (Без крашей)
    local isVisible = true
    if S.WallCheckESP and humanoid.Health > 0 then
        local shouldCheck = (fc % 3 == 0) -- Проверяем раз в 3 кадра для нагрузки
        if shouldCheck then
            espRayParams.FilterDescendantsInstances = { LocalPlayer.Character, character }
            -- Оборачиваем в pcall, чтобы движок не выдал ошибку mod on nil
            local success, result = pcall(function()
                return workspace:Raycast(Camera.CFrame.Position, root.Position - Camera.CFrame.Position, espRayParams)
            end)
            
            if success then
                -- Если result == nil, значит луч не встретил препятствий (игрок виден)
                data._wallVisible = (result == nil)
            else
                -- Если pcall поймал внутреннюю ошибку движка, считаем что за стеной
                data._wallVisible = false 
            end
        end
        isVisible = data._wallVisible
    end

    local colorBox = getElementColor(player, "box")
    local colorBoxFill = getElementColor(player, "boxfill")
    local colorName = getElementColor(player, "name")
    local colorHealth = getElementColor(player, "health")
    local colorTracer = getElementColor(player, "tracer")
    local colorSkeleton = getElementColor(player, "skeleton")
    local colorHeadDot = getElementColor(player, "headdot")
    local colorChams = getElementColor(player, "chams")

    if S.WallCheckESP then
        if not isVisible then
            -- 🔴 КРАСНЫЙ (За стеной)
            colorBox = S.ColorHidden; colorBoxFill = S.ColorHidden; colorName = S.ColorHidden
            colorHealth = S.ColorHidden; colorTracer = S.ColorHidden; colorSkeleton = S.ColorHidden
            colorHeadDot = S.ColorHidden; colorChams = S.ColorHidden
        else
            -- 🟢 ЗЕЛЕНЫЙ (Виден)
            colorBox = S.ColorVisible; colorBoxFill = S.ColorVisible; colorName = S.ColorVisible
            colorHealth = S.ColorVisible; colorTracer = S.ColorVisible; colorSkeleton = S.ColorVisible
            colorHeadDot = S.ColorVisible; colorChams = S.ColorVisible
        end
    end

    if S.Box and S.BoxFill then
        data.boxFill.Position = Vector2.new(minX, minY)
        data.boxFill.Size = Vector2.new(maxX - minX, maxY - minY)
        data.boxFill.Color = colorBoxFill
        data.boxFill.Transparency = 1 - (0.15 * alpha)
        data.boxFill.Visible = true
    else
        data.boxFill.Visible = false
    end

    if S.Box then
        if S.BoxStyle == "Corners" then
            local cLen = math.min(maxX - minX, maxY - minY) * 0.22
            local segs = {
                { Vector2.new(minX, minY), Vector2.new(minX + cLen, minY) },
                { Vector2.new(minX, minY), Vector2.new(minX, minY + cLen) },
                { Vector2.new(maxX, minY), Vector2.new(maxX - cLen, minY) },
                { Vector2.new(maxX, minY), Vector2.new(maxX, minY + cLen) },
                { Vector2.new(maxX, maxY), Vector2.new(maxX - cLen, maxY) },
                { Vector2.new(maxX, maxY), Vector2.new(maxX, maxY - cLen) },
                { Vector2.new(minX, maxY), Vector2.new(minX + cLen, maxY) },
                { Vector2.new(minX, maxY), Vector2.new(minX, maxY - cLen) },
            }
            for i = 1, 8 do
                local seg = segs[i]
                data.box[i].From, data.box[i].To = seg[1], seg[2]
                data.box[i].Color = colorBox
                data.box[i].Thickness = S.BoxThickness
                data.box[i].Transparency = alpha
                data.box[i].Visible = true
            end
        else
            data.box[1].From, data.box[1].To = Vector2.new(minX, minY), Vector2.new(maxX, minY)
            data.box[2].From, data.box[2].To = Vector2.new(maxX, minY), Vector2.new(maxX, maxY)
            data.box[3].From, data.box[3].To = Vector2.new(maxX, maxY), Vector2.new(minX, maxY)
            data.box[4].From, data.box[4].To = Vector2.new(minX, maxY), Vector2.new(minX, minY)
            for i = 1, 4 do
                data.box[i].Color = colorBox
                data.box[i].Thickness = S.BoxThickness
                data.box[i].Transparency = alpha
                data.box[i].Visible = true
            end
            for i = 5, 8 do data.box[i].Visible = false end
        end
    else
        for _, l in ipairs(data.box) do l.Visible = false end
    end

    local cx = (minX + maxX) / 2

    if S.HealthBar then
        local hp = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        local barW, barH = 3, maxY - minY
        local bx, by = minX - barW - 3, minY
        data.healthBg.Position = Vector2.new(bx, by)
        data.healthBg.Size = Vector2.new(barW, barH)
        data.healthBg.Transparency = (1 - alpha) + 0.4 * alpha
        data.healthBg.Visible = true
        data.healthBar.Position = Vector2.new(bx, by + barH * (1 - hp))
        data.healthBar.Size = Vector2.new(barW, barH * hp)
        data.healthBar.Color = (S.UseTeamColor and isVisible)
            and Color3.fromRGB(math.floor(255*(1-hp)), math.floor(255*hp), 0)
            or colorHealth
        data.healthBar.Transparency = alpha
        data.healthBar.Visible = true
    else
        data.healthBg.Visible = false
        data.healthBar.Visible = false
    end

    if S.Tracer then
        data.tracer.From = viewportOrigin()
        data.tracer.To = Vector2.new(cx, maxY)
        data.tracer.Color = colorTracer
        data.tracer.Transparency = alpha
        data.tracer.Visible = true
    else
        data.tracer.Visible = false
    end

    if S.HeadDot then
        local head = character:FindFirstChild("Head")
        if head then
            local top    = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y/2, 0))
            local bottom = Camera:WorldToViewportPoint(head.Position - Vector3.new(0, head.Size.Y/2, 0))
            local center = Camera:WorldToViewportPoint(head.Position)
            local r = math.abs(top.Y - bottom.Y) / 2
            if center.Z > 0 and r > 0.5 then
                data.headDot.Position = Vector2.new(center.X, center.Y)
                data.headDot.Radius = math.max(r * 0.75, 2)
                data.headDot.Color = colorHeadDot
                data.headDot.Transparency = alpha
                data.headDot.Visible = true
            else data.headDot.Visible = false end
        else data.headDot.Visible = false end
    else data.headDot.Visible = false end

    if S.Skeleton then
        for i, conn in ipairs(data.skelConns) do
            local line = data.skelLines[i]; if not line then break end
            local p0, p1 = conn[1], conn[2]
            if p0 and p1 and p0.Parent and p1.Parent then
                local s0 = Camera:WorldToViewportPoint(p0.Position)
                local s1 = Camera:WorldToViewportPoint(p1.Position)
                if s0.Z > 0 and s1.Z > 0 then
                    line.From = Vector2.new(s0.X, s0.Y)
                    line.To   = Vector2.new(s1.X, s1.Y)
                    line.Color = colorSkeleton
                    line.Transparency = alpha
                    line.Visible = true
                else line.Visible = false end
            else line.Visible = false end
        end
        for i = #data.skelConns + 1, #data.skelLines do data.skelLines[i].Visible = false end
    else
        for _, l in ipairs(data.skelLines) do l.Visible = false end
    end

    if S.Chams then
        if data.highlight.Adornee ~= character then
            data.highlight.Adornee = character
            data.highlight.Parent  = character
        end
        data.highlight.FillColor        = colorChams
        data.highlight.OutlineColor     = colorChams
        data.highlight.FillTransparency = S.ChamsTransp
        data.highlight.Enabled          = true
    else
        data.highlight.Enabled = false
    end

    if data.gui then
        local head = character:FindFirstChild("Head") or root
        if head and head.Parent == character and data.gui.Parent ~= character then
            data.gui.Adornee = head
            data.gui.Parent = character
        end
        
        if head and data.gui.Parent == character then
            data.gui.StudsOffset = Vector3.new(0, head.Size.Y/2 + 0.5, 0)
            data.gui.Enabled = S.Name or S.Distance or S.Tool or S.HealthText or S.Avatars
        else
            data.gui.Enabled = false
        end
        
        local font = getFont()
        local textAlpha = 1 - alpha

        data.avatarLbl.Visible = S.Avatars
        data.nameLbl.Visible = S.Name
        data.topFrame.Visible = S.Avatars or S.Name
        data.avatarLbl.ImageTransparency = textAlpha

        if S.Name then
            data.nameLbl.Text = (player.DisplayName ~= "" and player.DisplayName) or player.Name
            data.nameLbl.TextColor3 = colorName
            data.nameLbl.Font = font
            data.nameLbl.TextSize = S.TextSize
            data.nameLbl.TextTransparency = textAlpha
            data.nameLbl.TextStrokeTransparency = textAlpha
        end

        data.distLbl.Visible = S.Distance
        if S.Distance then
            data.distLbl.Text = string.format("[%dm]", math.floor(dist))
            data.distLbl.TextColor3 = colorName
            data.distLbl.Font = font
            data.distLbl.TextSize = S.TextSize - 2
            data.distLbl.TextTransparency = textAlpha
            data.distLbl.TextStrokeTransparency = textAlpha
        end

        data.toolLbl.Visible = S.Tool
        if S.Tool then
            local tool = character:FindFirstChildWhichIsA("Tool")
            if tool then
                data.toolLbl.Text = tool.Name
                data.toolLbl.TextColor3 = colorName
                data.toolLbl.Font = font
                data.toolLbl.TextSize = S.TextSize - 2
                data.toolLbl.TextTransparency = textAlpha
                data.toolLbl.TextStrokeTransparency = textAlpha
            else data.toolLbl.Visible = false end
        end

        data.hpLbl.Visible = S.HealthText and S.HealthBar
        if S.HealthText and S.HealthBar then
            data.hpLbl.Text = tostring(math.ceil(humanoid.Health))
            data.hpLbl.TextColor3 = colorName
            data.hpLbl.Font = font
            data.hpLbl.TextSize = S.TextSize - 2
            data.hpLbl.TextTransparency = textAlpha
            data.hpLbl.TextStrokeTransparency = textAlpha
        end
    end
end

